---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Home content is missing');
const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <h1 class="visually-hidden">京橋内科医院</h1>
  <article class="page-content home-content">
    <Content />
  </article>
</SiteLayout>
