---
const googleMapUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.978848610622!2d139.7707592!3d35.6775228!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188be2e7c52857%3A0x2696122232828afb!2z5Lqs5qmL5YaF56eR5Yy76Zmi!5e0!3m2!1sja!2sjp!4v1777471050376!5m2!1sja!2sjp';
---

<section class="map-embed" aria-labelledby="map-title">
  <h2 id="map-title" class="visually-hidden">京橋内科医院 周辺地図</h2>
  <div class="map-frame">
    <iframe
      title="Google マップ: 京橋内科医院"
      src={googleMapUrl}
      width="1200"
      height="600"
      loading="eager"
      referrerpolicy="no-referrer-when-downgrade"
      tabindex="-1"
    ></iframe>
    <a class="map-open-link" href="https://maps.app.goo.gl/NF3RKk3aTCTMRBB19" target="_blank" rel="noopener noreferrer" aria-label="京橋内科医院をGoogle マップで開く（新しいタブ）"></a>
  </div>
</section>
