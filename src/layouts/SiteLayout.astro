---
import '@fontsource-variable/noto-sans-jp';
import logo from '../assets/site/logo.png';
import headingIcon from '../assets/site/heading-icon.png';
import GoogleMap from '../components/GoogleMap.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isPublicProduction = import.meta.env.PUBLIC_SITE_ENV === 'production';
const navigation = [
  { label: 'Home', href: base },
  { label: '医院紹介', href: `${base}home/about/` },
  { label: '診療内容', href: `${base}home/medical/` },
  { label: '来院案内', href: `${base}home/first/` },
  { label: 'アクセス', href: `${base}home/access/` },
  { label: 'プライバシーポリシー', href: `${base}home/policy/` },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: '京橋内科医院',
  url: Astro.site ? new URL(base, Astro.site).toString() : undefined,
  telephone: '+81-3-3567-8311',
  address: {
    '@type': 'PostalAddress',
    postalCode: '104-0031',
    addressRegion: '東京都',
    addressLocality: '中央区',
    streetAddress: '京橋2-8-21 昭和ビル別館4F',
    addressCountry: 'JP',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:30',
      closes: '13:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '14:30',
      closes: '18:30',
    },
  ],
};
---

<!doctype html>
<html lang="ja" style={`--heading-icon: url(${headingIcon.src})`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={isPublicProduction ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="icon" type="image/png" href={headingIcon.src} />
    <title>{title === 'Home' ? '京橋内科医院' : `${title} | 京橋内科医院`}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">内容をスキップ</a>
    <header class="site-header site-shell">
      <div class="header-row">
        <a class="brand" href={base} aria-label="京橋内科医院 ホーム">
          <img src={logo.src} width={logo.width} height={logo.height} alt="京橋内科医院" />
        </a>
        <div class="header-contact">
          <span>〒104-0031</span>
          <a href="https://www.google.com/maps/search/?api=1&query=東京都中央区京橋2-8-21">東京都中央区京橋2-8-21</a>
          <span>昭和ビル別館4F</span>
          <a href="tel:0335678311">TEL: 03-3567-8311</a>
        </div>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="メニューを開く">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav id="site-navigation" class="site-navigation" aria-label="ナビゲーション">
        <ul>
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={currentPath === new URL(item.href, Astro.url).pathname ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main-content" class="site-shell">
      <slot />
    </main>

    <GoogleMap />

    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <section class="footer-address" aria-labelledby="footer-clinic-name">
          <h2 id="footer-clinic-name">京橋内科医院</h2>
          <p>〒104-0031<br /><a href="https://www.google.com/maps/search/?api=1&query=東京都中央区京橋2-8-21">東京都中央区京橋2-8-21</a><br />昭和ビル別館4F</p>
          <p><a class="footer-phone" href="tel:0335678311">TEL: 03-3567-8311</a></p>
          <p>東京メトロ銀座線 京橋駅 6番、7番出口より徒歩1分<br />JR各線 東京駅 八重洲南口より徒歩5分<br />都営地下鉄浅草線 宝町駅 A5番、A6番、A7番出口より徒歩3分</p>
          <p><strong>予約について</strong><br />予約制ではありませんが、検査予定などある方には、次回の予約（優先予約）のお取り扱いをいたします。</p>
        </section>
        <section class="footer-hours" aria-labelledby="hours-title">
          <h2 id="hours-title" class="visually-hidden">診療時間</h2>
          <div class="table-scroll" tabindex="0" role="region" aria-label="診療時間表。横にスクロールできます">
            <table>
              <thead><tr><th>診療時間</th><th>月</th><th>火</th><th>水</th><th>木</th><th>金</th><th>土</th><th>日</th></tr></thead>
              <tbody>
                <tr><th>9:30-13:00</th><td>○</td><td>○</td><td>○</td><td>○</td><td>○</td><td>／</td><td>／</td></tr>
                <tr><th>14:30-18:30</th><td>○</td><td>○</td><td>○</td><td>○</td><td>○</td><td>／</td><td>／</td></tr>
              </tbody>
            </table>
          </div>
          <p>診療受付開始時間は診療時間の10分前からです。</p>
          <p>※休診日：土日祝日</p>
        </section>
      </div>
      <p class="copyright">© 2026 京橋内科医院</p>
    </footer>

    <script>
      const button = document.querySelector('.menu-button');
      const navigation = document.querySelector('.site-navigation');
      const closeMenu = () => {
        button?.setAttribute('aria-expanded', 'false');
        button?.setAttribute('aria-label', 'メニューを開く');
        navigation?.classList.remove('is-open');
      };
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        button.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
        navigation?.classList.toggle('is-open', !open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          button?.focus();
        }
      });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    </script>
  </body>
</html>