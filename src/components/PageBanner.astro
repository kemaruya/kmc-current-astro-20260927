---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image: ImageMetadata;
}

const { title, image } = Astro.props;
const headingId = `page-title-${title}`;
---

<section class="page-banner" aria-labelledby={headingId}>
  <Image
    src={image}
    alt=""
    widths={[640, 960, 1280, 1536, 1920]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <h1 id={headingId}>{title}</h1>
</section>